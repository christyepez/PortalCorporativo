                                          "catalog":  {
                                                          "Destinations":  {
                                                                               "primary":  {
                                                                                               "Address":  "http://catalog-api:8080/"
                                                                                           }
                                                                           }
                                                      },
                                          "content":  {
                                                          "Destinations":  {
                                                                               "primary":  {
                                                                                               "Address":  "http://content-api:8080/"
                                                                                           }
                                                                           }
                                                      },
                                          "integration":  {
                                                              "Destinations":  {
                                                                                   "primary":  {
                                                                                                   "Address":  "http://integration-api:8080/"
                                                                                               }
                                                                               }
                                                          },
                                          "reporting":  {
                                                            "Destinations":  {
                                                                                 "primary":  {
                                                                                                 "Address":  "http://reporting-api:8080/"
                                                                                             }
                                                                             }
                                                        },
                                          "crm":  {
                                                      "Destinations":  {
                                                                           "primary":  {
                                                                                           "Address":  "http://crm-api:8080/"
                                                                                       }
