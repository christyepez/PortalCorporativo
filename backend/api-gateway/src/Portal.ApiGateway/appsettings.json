                                                       },
                                          "configuration":  {
                                                                "Destinations":  {
                                                                                     "primary":  {
                                                                                                     "Address":  "http://configuration-api:8080/"
                                                                                                 }
                                                                                 }
                                                            },
                                          "menu":  {
                                                       "Destinations":  {
                                                                            "primary":  {
                                                                                            "Address":  "http://menu-api:8080/"
                                                                                        }
                                                                        }
                                                   },
                                          "audit":  {
                                                        "Destinations":  {
                                                                             "primary":  {
                                                                                             "Address":  "http://audit-api:8080/"
                                                                                         }
                                                                         }
                                                    },
                                          "notification":  {
