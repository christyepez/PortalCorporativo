                                                                                          {
                                                                                              "PathRemovePrefix":  "/api/historiaspaolin"
                                                                                          }
                                                                                      ]
                                                                   },
                                        "historiaspaolin":  {
                                                                "ClusterId":  "historiaspaolin",
                                                                "Match":  {
                                                                              "Path":  "/api/historiaspaolin/{**catch-all}"
                                                                          },
                                                                "AuthorizationPolicy":  "default",
                                                                "Transforms":  [
                                                                                   {
                                                                                       "PathRemovePrefix":  "/api/historiaspaolin"
                                                                                   }
                                                                               ]
                                                            },
                                        "hr-health":  {
                                                          "ClusterId":  "hr",
                                                          "Match":  {
                                                                        "Path":  "/api/hr/health/{**catch-all}"
                                                                    },
                                                          "Transforms":  [
