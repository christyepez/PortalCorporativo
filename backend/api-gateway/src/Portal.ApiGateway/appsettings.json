                                                                                                   }
                                                                                   }
                                                              },
                                          "hr":  {
                                                     "Destinations":  {
                                                                          "primary":  {
                                                                                          "Address":  "http://hr-api:8080/"
                                                                                      }
                                                                      }
                                                 }
                                      }
                     },
    "AllowedHosts":  "*"
}
