                                                     },
                                        "configuration":  {
                                                              "ClusterId":  "configuration",
                                                              "Match":  {
                                                                            "Path":  "/api/configuration/{**catch-all}"
                                                                        },
                                                              "AuthorizationPolicy":  "default"
                                                          },
                                        "menu":  {
