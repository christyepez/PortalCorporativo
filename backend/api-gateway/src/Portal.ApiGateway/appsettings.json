                                                                        "Path":  "/api/reporting/{**catch-all}"
                                                                    },
                                                          "AuthorizationPolicy":  "default"
                                                      },
                                        "crm-health":  {
                                                           "ClusterId":  "crm",
                                                           "Match":  {
                                                                         "Path":  "/api/crm/health/{**catch-all}"
                                                                     },
                                                           "Transforms":  [
                                                                              {
                                                                                  "PathRemovePrefix":  "/api/crm"
                                                                              }
                                                                          ]
                                                       },
                                        "crm":  {
                                                    "ClusterId":  "crm",
                                                    "Match":  {
                                                                  "Path":  "/api/crm/{**catch-all}"
                                                              },
                                                    "AuthorizationPolicy":  "default"
                                                },
                                        "financial-health":  {
                                                                 "ClusterId":  "financial",
                                                                 "Match":  {
                                                                               "Path":  "/api/financial/health/{**catch-all}"
                                                                           },
                                                                 "Transforms":  [
                                                                                    {
                                                                                        "PathRemovePrefix":  "/api/financial"
                                                                                    }
                                                                                ]
                                                             },
                                        "financial":  {
                                                          "ClusterId":  "financial",
                                                          "Match":  {
                                                                        "Path":  "/api/financial/{**catch-all}"
                                                                    },
                                                          "AuthorizationPolicy":  "default"
                                                      },
                                        "historiaspaolin-health":  {
